{
  "name": "@newcondo/property-service",
  "version": "1.0.0",
  "description": "Newcondo property service",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./routes": "./dist/routes/index.js",
    "./middleware": "./dist/middleware/index.js",
    "./services": "./dist/services/index.js",
    "./types": "./dist/types/index.js",
    "./controllers": "./dist/controllers/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "dev:watch": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts --watch src",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@newcondo/backend-shared": "workspace:*",
    "@newcondo/db": "workspace:*",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}