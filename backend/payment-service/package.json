{
  "name": "@newcondo/payment-service",
  "version": "1.0.0",
  "description": "Newcondo Payment Service",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./routes": "./dist/routes/index.js",
    "./middleware": "./dist/middleware/index.js",
    "./services": "./dist/services/index.js",
    "./types": "./dist/types/index.js",
    "./controllers": "./dist/controllers/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "dev:watch": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts --watch src",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@newcondo/backend-shared": "workspace:*",
    "@newcondo/db": "workspace:*",
    "axios": "^1.7.2",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.4",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}