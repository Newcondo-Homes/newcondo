{
  "name": "@newcondo/gateway",
  "version": "1.0.0",
  "description": "API Gateway for NewCondo microservices architecture",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docker:build": "docker build -t newcondo-gateway .",
    "docker:run": "docker run -p 8000:8000 --env-file .env newcondo-gateway",
    "docker:dev": "docker-compose up --build",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "api-gateway",
    "microservices",
    "nodejs",
    "express",
    "typescript",
    "newcondo"
  ],
  "author": "NewCondo Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "http-proxy-middleware": "^2.0.6",
    "redis": "^4.6.12",
    "ioredis": "^5.3.2",
    "express-rate-limit": "^7.1.5",
    "rate-limit-redis": "^4.2.0",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.11.0",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3",
    "async": "^3.2.5",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1",
    "crypto": "^1.0.1",
    "ms": "^2.1.3",
    "axios": "^1.6.2",
    "express-validator": "^7.0.1",
    "express-async-errors": "^3.1.1",
    "http-status-codes": "^2.3.0",
    "consul": "^0.40.0",
    "etcd3": "^1.1.2",
    "node-fetch": "^3.3.2",
    "prometheus-api-metrics": "^3.2.2",
    "prom-client": "^15.1.0",
    "express-prometheus-middleware": "^1.2.0",
    "elastic-apm-node": "^4.5.4",
    "jaeger-client": "^3.19.0",
    "opentracing": "^0.14.7",
    "express-opentracing": "^0.1.1",
    "express-slow-down": "^2.0.1",
    "express-brute": "^1.0.1",
    "express-brute-redis": "^0.0.1",
    "cookie-parser": "^1.4.6",
    "express-session": "^1.17.3",
    "connect-redis": "^7.1.0",
    "bcryptjs": "^2.4.3",
    "crypto-js": "^4.2.0",
    "node-cache": "^5.1.2",
    "memory-cache": "^0.2.0",
    "lru-cache": "^10.1.0",
    "bull": "^4.12.2",
    "bull-board": "^2.1.3",
    "agenda": "^5.0.0",
    "express-fileupload": "^1.4.3",
    "multer": "^1.4.5-lts.1",
    "stream": "^0.0.2",
    "events": "^3.3.0",
    "cluster": "^0.7.7",
    "os": "^0.1.2",
    "path": "^0.12.7",
    "url": "^0.11.3",
    "querystring": "^0.2.1",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.202",
    "@types/uuid": "^9.0.7",
    "@types/ms": "^0.7.34",
    "@types/node-cron": "^3.0.11",
    "@types/async": "^3.2.24",
    "@types/consul": "^0.40.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/express-session": "^1.17.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.2.1",
    "@types/express-fileupload": "^1.4.4",
    "@types/multer": "^1.4.11",
    "@types/supertest": "^6.0.2",
    "@types/jest": "^29.5.8",
    "typescript": "^5.3.3",
    "tsx": "^4.6.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.5",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "prettier": "^3.1.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "cross-env": "^7.0.3",
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/newcondo/newcondo-monorepo.git",
    "directory": "backend/gateway"
  },
  "bugs": {
    "url": "https://github.com/newcondo/newcondo-monorepo/issues"
  },
  "homepage": "https://github.com/newcondo/newcondo-monorepo#readme",
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/*.test.ts",
      "!src/**/*.spec.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "tsx src/server.ts"
  }
}