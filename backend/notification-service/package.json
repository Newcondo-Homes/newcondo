{
  "name": "@newcondo/notification-service",
  "version": "1.0.0",
  "description": "Newcondo notifications — persistence reads + real-time SSE stream (writes go through @newcondo/backend-shared notificationBus)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --exec ts-node src/server.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@newcondo/backend-shared": "workspace:*",
    "@newcondo/db": "workspace:*",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "nodemon": "^3.1.14"
  },
  "engines": { "node": ">=18.0.0" }
}
