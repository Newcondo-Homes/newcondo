{
  // backend/marking-service/tsconfig.json — REPLACES the current file.
  //
  // FIXES TS6059 ("file is not under rootDir"):
  // the old config had "../shared/src/**/*" in `include`, which drags shared's
  // SOURCES into this program. They sit outside rootDir ("./src"), so tsc has
  // nowhere to emit them — the same mechanism that was littering shared/src
  // with .js/.d.ts files. A project REFERENCE is the correct way to consume
  // another package: tsc reads shared's built dist/*.d.ts instead.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "disableSourceOfProjectReferenceRedirect": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node", "express"],
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@prisma/client": ["../../node_modules/.prisma/client/index.d.ts"],
      "@newcondo/db": ["../../packages/db/dist/index.d.ts"]
    }
  },
  // Force-load shared's ambient Express augmentation (req.user) — glob
  // includes can't reach across a package boundary.
  "files": ["../shared/src/types/express.d.ts"],
  "references": [
    { "path": "../shared" },
    { "path": "../property-service" }
  ],
  // ONLY this package's own sources. Never "../shared/src/**/*".
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts"]
}
