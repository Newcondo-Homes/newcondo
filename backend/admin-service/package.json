{
  "name": "@newcondo/admin-service",
  "version": "1.0.0",
  "description": "Admin dashboard service for Newcondo platform",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./routes": "./src/routes/index.ts",
    "./controllers": "./src/controllers/index.ts",
    "./services": "./src/services/index.ts",
    "./middleware": "./src/middleware/index.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "dev:standalone": "PORT=3006 nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "admin",
    "dashboard",
    "newcondo"
  ],
  "author": "Newcondo Team",
  "license": "MIT",
  "dependencies": {
    "@newcondo/backend-shared": "workspace:*",
    "@newcondo/db": "workspace:*",
    "@types/json2csv": "^5.0.7",
    "axios": "^1.16.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "json2csv": "6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}