{
  "name": "@newcondo/db",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "db:migrate": "prisma migrate dev --name init  --config prisma.config.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts",
    "db:seed": "tsx seed.ts",
    "db:reset": "prisma migrate reset --config prisma.config.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "prisma generate --config prisma.config.ts",
    "build": "tsc && node fix-imports.js",
    "clean": "rimraf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "prisma": "^7.8.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}