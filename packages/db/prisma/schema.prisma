// ============================================================================
// SUBSCRIPTION SYSTEM v2 (unchanged — see your original notes for the
// enforcement rules: free renters, property caps, commission rates,
// marking-job access, VA creation, renewal cron, founding cohorts)
// ============================================================================

model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  planType     SubscriptionPlan
  billingCycle BillingCycle     @default(MONTHLY)
  userRole     Role

  amountNaira      Decimal  @db.Decimal(10, 2)
  discountPercent  Decimal? @db.Decimal(5, 2)
  finalAmountNaira Decimal  @db.Decimal(10, 2)

  flwPlanId         String?
  flwSubscriptionId String? @unique
  flwCustomerToken  String?
  flwTransactionRef String?
  flwCustomerId     String?

  cardLast4  String?
  cardBrand  String?
  cardExpiry String?

  status             SubscriptionStatus @default(PENDING)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  pausedAt           DateTime?
  pausedUntil        DateTime?

  propertyListingCap   Int?
  currentPropertyCount Int  @default(0)

  isFoundingAgent     Boolean @default(false)
  foundingAgentNumber Int?

  isFreeRenterPlan         Boolean   @default(false)
  renterPaidPlanUnlockedAt DateTime?

  isFoundingMember     Boolean  @default(false)
  foundingMemberNumber Int?
  lockedRateNaira      Decimal? @db.Decimal(10, 2)

  canAccessMarkingJobs Boolean @default(false)

  autoRenew            Boolean   @default(true)
  nextRenewalAttempt   DateTime?
  renewalFailureCount  Int       @default(0)
  lastRenewalAttemptAt DateTime?

  virtualAccountCreated Boolean @default(false)

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  history  SubscriptionHistory[]
  invoices SubscriptionInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([planType])
  @@index([userRole])
  @@index([currentPeriodEnd])
  @@index([flwSubscriptionId])
  @@index([isFoundingAgent])
  @@index([isFoundingMember])
}

model SubscriptionHistory {
  id             String @id @default(cuid())
  subscriptionId String
  userId         String

  eventType  SubscriptionEvent
  fromStatus SubscriptionStatus?
  toStatus   SubscriptionStatus?
  fromPlan   SubscriptionPlan?
  toPlan     SubscriptionPlan?

  flwTransactionRef String?
  amountCharged     Decimal?       @db.Decimal(10, 2)
  paymentStatus     PaymentStatus?

  notes       String?
  triggeredBy String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([subscriptionId])
  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

model SubscriptionInvoice {
  id             String @id @default(cuid())
  subscriptionId String
  userId         String

  invoiceNumber String   @unique
  periodStart   DateTime
  periodEnd     DateTime
  amountNaira   Decimal  @db.Decimal(10, 2)
  currency      String   @default("NGN")

  status            InvoiceStatus @default(PENDING)
  flwTransactionRef String?       @unique
  flwTransactionId  String?       @unique
  paidAt            DateTime?
  failureReason     String?
  retryCount        Int           @default(0)
  nextRetryAt       DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model FlutterwavePlan {
  id String @id @default(cuid())

  planType    SubscriptionPlan @unique
  name        String
  description String?

  flwPlanId   String  @unique
  flwPlanCode String?

  amountNaira  Decimal      @db.Decimal(10, 2)
  billingCycle BillingCycle
  interval     String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planType])
  @@index([flwPlanId])
}

