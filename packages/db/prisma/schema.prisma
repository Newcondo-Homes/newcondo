// ============================================================================
// packages/db/prisma/schema.prisma — CANONICAL SCHEMA
// ============================================================================
// Base: your merged schema (original + dashboard features).
// This revision folds in ACCOUNT DELETION and makes every referential policy
// on User explicit. Changes are marked  // ++ DELETION
//
// Then run: npx prisma migrate dev --name account_deletion
//
// ----------------------------------------------------------------------------
// ACCOUNT DELETION — the model, in one place
// ----------------------------------------------------------------------------
// We never hard-delete a user on request. A rental, a payment, a commission
// split and a marking payout are records ABOUT A SECOND PERSON too — the
// landlord's tenancy history, the agent's earnings, Flutterwave's settlement
// trail. Destroying the User row would orphan every one of them and break the
// retention carve-out we publish at /privacy §12–13.
//
// Three states, in order:
//
//   1. DEACTIVATED   deletedAt      day 0   — locked out, listings hidden,
//                                             auto-renew off. REVERSIBLE.
//   2. ANONYMIZED    anonymizedAt   day 21  — name, email, phone, image, bvn,
//                                             dateOfBirth, address erased;
//                                             Document rows + S3 objects
//                                             destroyed; Account rows (Facebook
//                                             /Google) severed. IRREVERSIBLE.
//                                             This is NDPA erasure. /privacy §13
//                                             promises 30 days; running on day
//                                             21 leaves a 9-day margin, and 21
//                                             is the ceiling (see the constant).
//   3. PURGED        purgedAt       +18 mo  — residual anonymous shell removed.
//                                             purgeAfter = anonymizedAt + 18mo.
//
// Statutory records (Payment, PlatformRevenue, SubscriptionInvoice) outlive
// even the purge on their own tax/AML clock, in isolated archive storage.
//
// ----------------------------------------------------------------------------
// REFERENTIAL POLICY on User — why each relation is what it is
// ----------------------------------------------------------------------------
// These rules are NOT the deletion mechanism (the app anonymizes in place).
// They are the safety net underneath it, and they matter at two moments:
// the 18-month purge, and any admin force-delete or bad migration.
//
//   CASCADE   pure artifacts of the account — meaningless without the user and
//             nobody else's record: Account, Session, Authenticator,
//             RefreshToken, FeatureFlag, Document, BankAccount, Notification,
//             Subscription, SubscriptionHistory, ServiceSubscription,
//             AgentInvite, AccountDeletionRequest.
//
//   SET NULL  the record is worth keeping, the identity is not. Requires an
//             optional FK: EventLog.user, Property.agent, Rental.invitedBy,
//             Payment.subAgent, PropertyMarkingJob.assignedAgent,
//             TenantInvite.renter, SubscriptionInvoice.user.
//
//   RESTRICT  financial, legal, or someone else's record — a delete here must
//             fail loudly. Declared explicitly below even where Prisma would
//             default to it, because the 18-month purge counts every Restrict
//             relation before attempting a row delete. Miss one and the purge
//             throws nightly forever.
//
// PaymentAttemptLog is deliberately Restrict: it is the evidence that the
// Flutterwave fraud rate stays under 0.10% of monthly turnover (cl. 12.2).
// Losing it to a cascade would delete the proof that the rate is fine.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  phone         String?   @unique
  emailVerified DateTime?
  phoneVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(RENTER)
  userType      UserType?

  subscription         Subscription?
  subscriptionHistory  SubscriptionHistory[]
  subscriptionInvoices SubscriptionInvoice[]

  // Verification fields
  verificationStatus          VerificationStatus @default(PENDING)
  verificationRejectionReason String?
  verifiedAt                  DateTime?
  verifiedBy                  String?

  // Profile fields
  dateOfBirth DateTime?
  address     String?
  city        String?
  state       String?
  country     String?   @default("Nigeria")

  // ++ ADDED — BVN powers Flutterwave permanent virtual-account creation for
  // renters at checkout (escrow safety + compliance). Encrypt at rest.
  bvn String?

  // ++ ADDED — payout automation for owners/agents: OFF | INSTANT | WEEKLY | MONTHLY
  autoPayoutMode String @default("OFF")

  // B2B specific fields for property managers
  companyName       String?
  businessRegNumber String?
  isB2BCustomer     Boolean @default(false)

  // Premium status
  isPremium        Boolean   @default(false)
  premiumExpiresAt DateTime?

  // Referral tracking — also used as the unique code inside share/promo URLs
  referralCode String @unique @default(cuid())
  // ++ MONEY CORE / REFERRALS v2 — a disabled code stops new attributions but
  // keeps existing Referral rows (and their rewards) intact.
  referralCodeDisabledAt DateTime?

  // Agent specific fields
  isAvailableForMarking Boolean  @default(false)
  agentServiceAreas     String[]
  agentReliabilityScore Decimal? @db.Decimal(3, 2)
  totalMarkingJobs      Int      @default(0)
  completedMarkingJobs  Int      @default(0)

  // ++ DELETION — account lifecycle. See the header for the full model.
  //
  // deletedAt     set the moment deletion is requested. The user cannot sign
  //               in, the profile stops resolving publicly, listings are
  //               hidden. Reversible until anonymizedAt is set (21 days).
  // anonymizedAt  identity erasure completed. Once set, nothing on this row
  //               identifies a person and there is nothing to restore.
  // purgeAfter    anonymizedAt + 18 months — when the residual shell may go.
  // purgedAt      the shell was stripped or the row deleted.
  //
  // EVERY query that serves a user-facing surface must filter deletedAt: null.
  // A deactivated owner's listings, an agent's public profile and a renter's
  // enquiries all have to disappear on day 0, not day 21.
  deletedAt    DateTime?
  anonymizedAt DateTime?
  purgeAfter   DateTime?
  purgedAt     DateTime?

  // Relations
  accounts      Account[]
  sessions      Session[]
  properties    Property[] @relation("PropertyOwner")
  agentListings Property[] @relation("PropertyAgent")

  // User Referral System
  referrals  Referral[]       @relation("Referrer")
  referredBy Referral?        @relation("Referred")
  rewards    ReferralReward[] @relation("UserRewards")

  // Agent Referral System
  agentReferrals     AgentReferral[]    @relation("AgentReferrals")
  promotionRequests  PromotionRequest[] @relation("PromotionRequester")
  ownedPromotionReqs PromotionRequest[] @relation("PromotionOwner")

  authenticator        Authenticator[]
  featureFlags         FeatureFlag[]
  events               EventLog[]           @relation("UserEvents")
  payments             Payment[]
  rentals              Rental[]
  virtualAccounts      VirtualAccount[]
  assignedMarkingJobs  PropertyMarkingJob[] @relation("AssignedAgent")
  requestedMarkingJobs PropertyMarkingJob[] @relation("RequestingUser")
  supportTickets       SupportTicket[]
  adminActions         AdminAction[]
  refreshToken         RefreshToken[]
  documents            Document[]

  // ++ ADDED relations
  notifications        Notification[]
  bankAccounts         BankAccount[]
  // ++ MONEY CORE — the user's ledger wallets (available + pending). Balances
  // are DERIVED from LedgerEntry rows; there is no balance column to trust.
  ledgerAccounts       LedgerAccount[]
  shareLinks           ShareLink[]          @relation("ShareLinkCreator")
  sentTenantInvites    TenantInvite[]       @relation("TenantInviteSender")
  usedTenantInvites    TenantInvite[]       @relation("TenantInviteRenter")
  sentAgentInvites     AgentInvite[]        @relation("AgentInviteOwner")
  linksAsOwner         OwnerAgentLink[]     @relation("OwnerAgentLinkOwner")
  linksAsAgent         OwnerAgentLink[]     @relation("OwnerAgentLinkAgent")
  markingQueueEntries  MarkingQueueEntry[]  @relation("MarkingQueueAgent")
  subAgentPayments     Payment[]            @relation("PaymentSubAgent")
  invitedRentals       Rental[]             @relation("RentalInviter")
  serviceSubscription  ServiceSubscription?
  requestedServiceJobs ServiceJob[]         @relation("ServiceJobRequester")

  // ++ DELETION
  deletionRequests AccountDeletionRequest[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  disputes           Dispute[]
  disputeComments    DisputeComment[]
  disputeEvidences   DisputeEvidence[]
  paymentAttemptLogs PaymentAttemptLog[]

  // ++ VENDORS
  vendorProfile       Vendor?            @relation("VendorUser")
  generatedVisitCodes ServiceVisitCode[] @relation("VisitCodeGenerator")

  @@index([email])
  @@index([phone])
  @@index([verificationStatus])
  @@index([role])
  @@index([userType])
  @@index([isAvailableForMarking])
  @@index([referralCode])
  // ++ DELETION — deletedAt is read on every authenticated request and on every
  // public listing query, so it is indexed both alone and with role.
  @@index([deletedAt])
  @@index([anonymizedAt])
  @@index([purgeAfter])
  @@index([role, deletedAt])
}

enum Role {
  OWNER
  AGENT
  RENTER
  ADMIN
  VENDOR // ++ VENDORS — service providers; sign in to apps/vendors only
}

enum IdDocumentType {
  NIN
  BVN
  PASSPORT
  VOTERS_CARD
  DRIVERS_LICENSE
}

// ============================================================================
// ++ DELETION — the deletion request itself
// ============================================================================
// One row per request, including refused ones: a user who asked and was told
// to settle an obligation first has still exercised an NDPA right, and we must
// be able to show the date and the reason we gave.
//
// confirmationCode doubles as the Meta data-deletion confirmation code and the
// path segment of the public status URL handed back to Facebook, which is why
// this model carries no personal data of its own.
// ============================================================================
model AccountDeletionRequest {
  id     String @id @default(cuid())
  userId String

  /// Role at the time of the request. The erasure procedure DIFFERS by role,
  /// and User.role may itself be scrubbed later, so it is snapshotted here.
  roleAtRequest Role
  status        AccountDeletionStatus @default(PENDING)
  source        AccountDeletionSource @default(IN_APP)

  /// Public lookup code — Meta's confirmation_code and our status URL segment.
  confirmationCode String @unique @default(cuid())

  reason     String?
  reasonNote String? @db.Text

  /// What existed at request time — the evidence that we deleted what we said
  /// we deleted, kept after the records themselves are gone.
  snapshot Json?

  requestedAt    DateTime  @default(now())
  anonymizeAfter DateTime // requestedAt + grace window (21 days)
  anonymizedAt   DateTime?
  purgeAfter     DateTime?
  purgedAt       DateTime?
  cancelledAt    DateTime?
  cancelledBy    String?

  /// Counters written by the erasure run, for the completion email and audit.
  documentsDeleted Int @default(0)
  s3ObjectsDeleted Int @default(0)
  photosDeleted    Int @default(0)
  propertiesClosed Int @default(0)

  /// Why it was refused, verbatim, when status is BLOCKED.
  blockedReason String? @db.Text

  requestIp String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([anonymizeAfter])
  @@index([purgeAfter])
}

enum AccountDeletionStatus {
  PENDING // deactivated, inside the reversible grace window
  CANCELLED // user came back before the window closed
  ANONYMIZED // identity erased; pseudonymous financial shell retained
  PURGED // residual data destroyed
  BLOCKED // requested but refused — an obligation is still open
}

enum AccountDeletionSource {
  IN_APP // settings → Delete account  (Meta requires this route to exist)
  EMAIL // info@newcondo.homes, identity verified by hand
  META_CALLBACK // Facebook "Remove app" data-deletion callback
  ADMIN // enforcement / ban with erasure
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Cascade: severing the Facebook/Google link IS part of erasure — /privacy
  // §13 promises we delete data received through social login.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Document {
  id         String  @id @default(cuid())
  userId     String
  propertyId String?

  documentType DocumentType
  documentSide DocumentSide?
  pageNumber   Int?

  documentNumber String?

  fileName      String?
  fileUrl       String? // CloudFront URL or presigned URL
  s3Key         String? // raw S3 key e.g. "users/clx8j/identity/nin/front_uuid.jpg"
  fileSizeBytes Int?
  mimeType      String?

  status            DocumentStatus @default(PENDING)
  verificationNotes String?

  isRequired Boolean   @default(true)
  expiresAt  DateTime?

  // Cascade on BOTH sides. Identity documents (NIN, BVN, ID scans) and
  // ownership documents are the most sensitive thing we hold and nothing
  // justifies keeping them past erasure. The rows go here; the S3 objects are
  // deleted by accountAnonymization.service.ts, which reads s3Key first.
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade) // ++ DELETION

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, documentType, documentSide, pageNumber, propertyId], name: "unique_document_variant")
  @@index([userId])
  @@index([propertyId])
  @@index([documentType])
  @@index([status])
  @@index([documentNumber])
}

enum DocumentSide {
  FRONT
  BACK
  SINGLE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Property {
  id          String @id @default(cuid())
  title       String
  description String

  structure PropertyStructure @default(SINGLE_UNIT)

  price    Decimal? @db.Decimal(10, 2)
  currency String   @default("NGN")

  // Location
  address        String
  city           String
  state          String
  country        String  @default("Nigeria")
  gpsCoordinates String?

  // Property Boundary Information — this IS the verified "mark"
  boundaryCoordinates Json?
  boundaryVerified    Boolean   @default(false)
  boundaryMarkedBy    String?
  boundaryMarkedAt    DateTime?
  boundaryImages      String[]
  buildingFingerprint String?

  // ++ ADDED — S3 key of the AI-segmented green mask PNG, re-drawn as the
  // coloured overlay whenever the map loads (marking segmentation pipeline).
  boundaryMaskImageKey String?

  // Building-level details (multi-family)
  totalUnits       Int?
  availableUnits   Int?
  buildingFeatures String[]

  // Property details (single units)
  propertyType PropertyType @default(APARTMENT)
  bedrooms     Int?
  bathrooms    Int?
  area         String?
  features     String[]

  // Ownership & Agency
  ownerId        String
  agentId        String?
  isOwnerListing Boolean @default(true)

  images PropertyImage[]

  // Status & Approval
  status              PropertyStatus      @default(DRAFT)
  adminApprovalStatus AdminApprovalStatus @default(PENDING)
  rejectionReason     String?
  approvedAt          DateTime?
  approvedBy          String?

  // Rental & Availability (single units)
  isAvailable       Boolean   @default(true)
  availableFrom     DateTime?
  isPaymentLocked   Boolean   @default(false)
  paymentLockExpiry DateTime?

  suspendedBySubscription Boolean @default(false)

  // ++ MONEY CORE — set when the owner discontinued this property's monthly
  // service. The property survives (only DELETE removes it); it is simply off
  // the market until a plan is chosen again. Distinct from
  // suspendedBySubscription, which is the ACCOUNT-level lapse and is restored
  // in bulk on payment — a discontinued property must never come back that way.
  offPlanAt DateTime?

  // Sharing & Marketing
  shareableLink String? @unique
  viewCount     Int     @default(0)
  favoriteCount Int     @default(0)

  // ++ DELETION
  // owner  Restrict — a listing must never silently vanish with its owner. On
  //        erasure, a property with no payment/marking/rental history is
  //        deleted explicitly; one with history survives de-identified (photos
  //        and ownership docs destroyed, address generalized to "City, State",
  //        GPS coarsened to a ~1 km grid per /privacy §12).
  // agent  SetNull — the listing survives and reverts to an owner listing;
  //        the owner can invite another agent. Same effect as resigning.
  owner User  @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  agent User? @relation("PropertyAgent", fields: [agentId], references: [id], onDelete: SetNull)

  units PropertyUnit[]

  rentals          Rental[]
  duplicateReports PropertyDuplicate[]
  markingJobs      PropertyMarkingJob[]
  virtualAccount   VirtualAccount?
  documents        Document[]

  subscriptionLine PropertySubscription?

  agentReferrals    AgentReferral[]            @relation("PropertyReferrals")
  promotionRequests PromotionRequest[]         @relation("PromotionRequests")
  promotionSettings PropertyPromotionSettings?

  // ++ ADDED relations
  shareLinks    ShareLink[]
  tenantInvites TenantInvite[]
  serviceJobs   ServiceJob[]

  // ++ VENDORS
  vendorAssignments VendorAssignment[]
  serviceWindow     PropertyServiceWindow?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  paymentAttemptLogs PaymentAttemptLog[]

  @@index([ownerId])
  @@index([agentId])
  @@index([status])
  @@index([adminApprovalStatus])
  @@index([city, state])
  @@index([propertyType])
  @@index([price])
  @@index([isAvailable])
  @@index([buildingFingerprint])
  @@index([boundaryVerified])
  @@index([structure])
  @@index([totalUnits])
  @@index([availableUnits])
  @@index([suspendedBySubscription])
}

model PropertyUnit {
  id         String @id @default(cuid())
  propertyId String

  unitNumber String
  floor      Int?

  bedrooms  Int?
  bathrooms Int?
  area      String?
  features  String[]

  price    Decimal @db.Decimal(10, 2)
  currency String  @default("NGN")

  status        UnitStatus @default(AVAILABLE)
  isAvailable   Boolean    @default(true)
  availableFrom DateTime?

  isPaymentLocked   Boolean   @default(false)
  paymentLockExpiry DateTime?

  images PropertyUnitImage[]

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentals  Rental[]

  // ++ ADDED — invites can be scoped to one flat
  tenantInvites TenantInvite[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  paymentAttemptLogs PaymentAttemptLog[]

  @@unique([propertyId, unitNumber], name: "unique_unit_per_property")
  @@index([propertyId])
  @@index([status])
  @@index([isAvailable])
  @@index([price])
  @@index([bedrooms])
  @@index([floor])
}

model PaymentAttemptLog {
  id            String   @id @default(cuid())
  userId        String
  propertyId    String
  unitId        String?
  amount        Decimal  @db.Decimal(10, 2)
  status        String
  failureReason String?
  lockAcquired  Boolean  @default(false)
  lockDuration  Int?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  // ++ DELETION — Restrict. This table is the raw material for the monthly
  // Flutterwave fraud-rate check (cl. 12.2: termination above 0.10% of
  // turnover). Erasure nulls ipAddress and userAgent; the row itself stays.
  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  property Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit     PropertyUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@index([createdAt])
}

model PropertyUnitImage {
  id        String  @id @default(cuid())
  unitId    String
  url       String
  altText   String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)

  unit PropertyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([unitId])
  @@index([isPrimary])
}

enum PropertyType {
  APARTMENT
  HOUSE
  DUPLEX
  ROOM
  SHARED_APARTMENT
  OFFICE
  SHOP
  WAREHOUSE
}

enum PropertyStatus {
  DRAFT
  PENDING
  PUBLISHED
  RENTED
  UNAVAILABLE
}

enum PropertyStructure {
  SINGLE_UNIT
  MULTI_FAMILY
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
  UNDER_CONSTRUCTION // ++ ADDED — dashboard shows per-flat "Under construction"
}

enum AdminApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserType {
  OWNER
  PROPERTY_MANAGER
  AGENT
  RENTER
  ADMIN
}

enum DocumentType {
  NIN
  BVN
  PASSPORT
  VOTERS_CARD
  DRIVERS_LICENSE
  SELFIE
  OWNERSHIP_DOCUMENT
  CONSENT_DOCUMENT
  UNDERTAKING_DOCUMENT
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  UTILITY_BILL
  BANK_STATEMENT
  OTHER
}

model PropertyImage {
  id         String  @id @default(cuid())
  propertyId String
  url        String
  altText    String?
  isPrimary  Boolean @default(false)
  order      Int     @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([propertyId])
}

model PropertyDuplicate {
  id                  String          @id @default(cuid())
  originalPropertyId  String
  duplicatePropertyId String
  reportedBy          String?
  status              DuplicateStatus @default(PENDING)
  resolution          String?
  resolvedBy          String?
  resolvedAt          DateTime?

  originalProperty Property @relation(fields: [originalPropertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([originalPropertyId])
  @@index([duplicatePropertyId])
  @@index([status])
}

enum DuplicateStatus {
  PENDING
  CONFIRMED_DUPLICATE
  NOT_DUPLICATE
  RESOLVED
}

// ---------------------------------------------------------------------------
// Property Marking Service — EXTENDED (not replaced)
// ---------------------------------------------------------------------------
model PropertyMarkingJob {
  id              String  @id @default(cuid())
  propertyId      String
  requestedBy     String
  assignedAgentId String?

  contactPersonName  String
  contactPersonPhone String
  accessInstructions String?
  preferredTime      DateTime?
  urgencyLevel       UrgencyLevel @default(NORMAL)

  markingFee    Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)

  status         MarkingJobStatus @default(QUEUED)
  assignedAt     DateTime?
  completedAt    DateTime?
  timeSlotExpiry DateTime?

  completionNotes  String?
  completionImages String[]
  boundaryData     Json?

  queuePosition     Int?
  maxCompletionTime DateTime?

  // ++ ADDED — how the owner/agent chose to get it marked
  method MarkingMethod @default(BROADCAST)

  // ++ ADDED — 72h owner confirmation window; payout drips if it lapses
  confirmDeadline DateTime?
  confirmedAt     DateTime?
  disputeReason   String?

  // ++ ADDED — S3 keys: satellite snapshot + AI green-mask (segmentation)
  snapshotImageKey String?
  maskImageKey     String?

  // ++ DELETION
  // requestingUser Restrict — the owner paid for this job; it is a financial
  //                record and the agent's proof of work.
  // assignedAgent  SetNull — a COMPLETED job keeps the (anonymized) agent id
  //                because the payout hangs off it. An unstarted job is
  //                returned to QUEUED by the erasure service so the owner
  //                isn't left waiting on someone who has gone.
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  requestingUser User     @relation("RequestingUser", fields: [requestedBy], references: [id], onDelete: Restrict)
  assignedAgent  User?    @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  // ++ ADDED — FCFS queue rows (3-hour slot per agent)
  queueEntries MarkingQueueEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([requestedBy])
  @@index([assignedAgentId])
  @@index([status])
  @@index([queuePosition])
}

// ++ ADDED — one row per agent who joined a broadcast job's queue
model MarkingQueueEntry {
  id            String    @id @default(cuid())
  jobId         String
  agentId       String
  position      Int
  slotStartedAt DateTime?
  completedAt   DateTime?
  abandonedAt   DateTime?
  createdAt     DateTime  @default(now())

  job   PropertyMarkingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // ++ DELETION — Cascade. A queue slot is pure plumbing; an unstarted slot is
  // released at day 0 so the next agent can take it today, not in two weeks.
  agent User               @relation("MarkingQueueAgent", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([jobId, agentId])
  @@index([jobId, position])
  @@index([agentId])
}

// ++ ADDED
enum MarkingMethod {
  SELF
  KNOWN_PERSON
  BROADCAST
  NEWCONDO
}

enum MarkingJobStatus {
  QUEUED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  AWAITING_CONFIRMATION // ++ ADDED — marked, waiting on the owner (72h)
  DISPUTED // ++ ADDED — owner disputed the boundary
}

enum UrgencyLevel {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Rental {
  id          String       @id @default(cuid())
  propertyId  String
  unitId      String?
  renterId    String
  startDate   DateTime
  endDate     DateTime?
  monthlyRent Decimal      @db.Decimal(10, 2)
  status      RentalStatus @default(ACTIVE)
  disputes    Dispute[]

  confirmationDeadline DateTime?
  isConfirmed          Boolean   @default(false)
  confirmedAt          DateTime?

  // ++ ADDED — set when the tenancy came from a tenant-invite link; surfaces
  // the tenant in the inviting owner's/agent's dashboard.
  invitedById String?

  // ++ DELETION
  // renter    Restrict — a tenancy is the LANDLORD's record as much as the
  //           renter's. It survives erasure with the renter reduced to an
  //           anonymous key. An ACTIVE tenancy blocks the request outright.
  // invitedBy SetNull — attribution only.
  property  Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit      PropertyUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  renter    User          @relation(fields: [renterId], references: [id], onDelete: Restrict)
  invitedBy User?         @relation("RentalInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([unitId])
  @@index([renterId])
  @@index([status])
  @@index([confirmationDeadline])
  @@index([invitedById])
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  rentalId     String?
  markingJobId String?
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("NGN")
  dispute      Dispute?

  paymentType   PaymentType
  status        PaymentStatus @default(PENDING)
  paymentMethod String?

  flutterwaveRef String? @unique
  transactionId  String? @unique

  agentCommission Decimal? @db.Decimal(10, 2)
  platformFee     Decimal? @db.Decimal(10, 2)
  ownerAmount     Decimal? @db.Decimal(10, 2)
  /// ++ FLW FEES — Flutterwave cost passed to the user (constants/fees.ts),
  /// whole naira, rounded up. Collections: included in `amount`. Withdrawals:
  /// deducted from `amount` (bank receives amount − processingFee).
  /// Non-refundable — Flutterwave keeps its fee on refunds.
  processingFee   Decimal? @db.Decimal(10, 2)

  confirmationPeriodEnd DateTime?
  isReleased            Boolean   @default(false)
  releasedAt            DateTime?

  description   String?
  failureReason String?
  paidAt        DateTime?

  // ++ ADDED — commission attribution. Pinned from the PROMO ShareLink used at
  // checkout; the ONLY source releaseEscrowAndSplit() reads, so a sub-agent's
  // cut can never be credited to the wrong person.
  subAgentId String?

  // ++ ADDED — idempotency flag for the escrow-release split
  commissionSettledAt DateTime?

  // ++ ADDED — S3 key of the cached branded PDF receipt (receipts/…)
  receiptKey String?

  // ++ ADDED — job params for webhook-driven flows (e.g. marking-fee payment
  // carries { propertyId, method, contactName, contactPhone, accessNotes })
  meta Json?

  // ++ DELETION
  // user     Restrict — tax, AML and chargeback obligations. This is the single
  //          most important Restrict in the schema: a payment row is the
  //          retention carve-out /privacy §12–13 discloses, and it survives
  //          erasure attached to the anonymous shell. Payments PENDING or HELD
  //          block a deletion request.
  // subAgent SetNull — commission attribution can be dropped if the sub-agent
  //          is gone; an unsettled split blocks their request anyway.
  user     User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  rental   Rental? @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  subAgent User?   @relation("PaymentSubAgent", fields: [subAgentId], references: [id], onDelete: SetNull)

  agentReferralConversion AgentReferralConversion?

  // ++ ADDED
  platformRevenue PlatformRevenue?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  referralConversion ReferralConversion?

  @@index([userId])
  @@index([rentalId])
  @@index([markingJobId])
  @@index([status])
  @@index([paymentType])
  @@index([confirmationPeriodEnd])
  @@index([subAgentId])
  // ++ DELETION — the agent payout blocker queries (subAgentId, status,
  // commissionSettledAt) on every deletion preview.
  @@index([subAgentId, commissionSettledAt])
}

enum PaymentType {
  RENT
  DEPOSIT
  AGENT_COMMISSION
  PREMIUM_UPGRADE
  PROPERTY_MARKING
  RENT_RELEASE // ++ ADDED — owner's net payout row at escrow release
  WITHDRAWAL // ++ ADDED — wallet → bank transfer
  SERVICE_FEE // ++ ADDED — vendor repair charged to the owner
  VENDOR_PAYOUT // ++ MONEY CORE — vendor paid from the central account
  REFERRAL_OVERRIDE // ++ MONEY CORE — founding-agent override credit
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  HELD
  RELEASED
}

// ++ ADDED — Newcondo's own commission cut, per settled payment
model PlatformRevenue {
  id        String   @id @default(cuid())
  paymentId String   @unique
  amount    Decimal  @db.Decimal(15, 2)
  source    String // RENT_COMMISSION | MARKING_FEE_MARGIN | SUBSCRIPTION
  createdAt DateTime @default(now())

  // Restrict — our own revenue record. Never cascades from anything.
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([source, createdAt])
}

// ++ ADDED — user payout bank accounts. DISTINCT from VirtualAccount:
// VAs are auto-created by Newcondo (main + one per marked property);
// BankAccounts are user-managed withdrawal destinations.
model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  bankName      String
  bankCode      String
  accountNumber String
  accountName   String // registered holder from Flutterwave name enquiry
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Cascade — a withdrawal destination is meaningless without its owner, and
  // account name + number are personal data that must go at erasure.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNumber])
  @@index([userId])
  @@index([isDefault])
}

// ++ ADDED — persisted notifications (badge counts + history). Written by
// backend-shared publishNotification(); delivered live over Redis → SSE.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  kind       String // marking | payment | wallet | verify | tenant | service | referral
  title      String
  body       String
  to         String // dashboard route the notification deep-links to
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ++ ADDED — share & promo links. The creator's referralCode is IN the URL
// ("{code}-{suffix}") and the full code is unique, so every click and payment
// is attributable to exactly one creator.
model ShareLink {
  code       String   @id // e.g. "ada4f2k-a8k2"
  kind       String // SHARE (lister) | PROMO (approved sub-agent → commission)
  propertyId String
  creatorId  String
  clicks     Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // ++ DELETION — Cascade. There is no isActive column, so a link can only be
  // deleted; the creator's referralCode is IN the URL, so a surviving link
  // would still carry their code. Deleted at erasure, not at deactivation
  // (the properties behind them are already UNAVAILABLE, and day 0 must stay
  // reversible).
  creator  User     @relation("ShareLinkCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([propertyId, creatorId, kind])
  @@index([creatorId])
}

// ++ ADDED — renters are invite-only. Single-use, sha256-hashed, 14-day link
// scoped to (inviter, property[, unit]). Accepting creates the Rental.
model TenantInvite {
  tokenHash  String    @id // sha256 of the raw token — raw never stored
  propertyId String
  unitId     String?
  inviterId  String
  renterId   String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  property Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     PropertyUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  // ++ DELETION — inviter Cascade (plumbing), renter SetNull (a USED invite is
  // part of the tenancy trail and outlives the renter's identity).
  inviter  User          @relation("TenantInviteSender", fields: [inviterId], references: [id], onDelete: Cascade)
  renter   User?         @relation("TenantInviteRenter", fields: [renterId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([inviterId])
  @@index([expiresAt])
}

// ++ ADDED — an agent may only list for an owner who invited them.
model AgentInvite {
  tokenHash  String    @id
  ownerId    String
  agentEmail String?
  agentId    String? // set on accept
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  // NOTE: agentEmail is personal data about a THIRD party (the invited agent),
  // held before they have an account. Unused invites are deleted at erasure.
  owner User @relation("AgentInviteOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([agentId]) // ++ DELETION — the erasure service sweeps by agentId
}

// ++ ADDED — the accepted relationship; powers the compulsory "property owner"
// dropdown in the agent's New Listing form.
model OwnerAgentLink {
  id        String   @id @default(cuid())
  ownerId   String
  agentId   String
  status    String   @default("ACTIVE") // ACTIVE | REVOKED
  createdAt DateTime @default(now())

  // Cascade both sides — a relationship row with one party missing is noise.
  owner User @relation("OwnerAgentLinkOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  agent User @relation("OwnerAgentLinkAgent", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([ownerId, agentId])
  @@index([agentId, status])
}

// ---------------------------------------------------------------------------
// ++ ADDED — third-party vendor services (fumigation, waste, inspection, repairs)
// ---------------------------------------------------------------------------
model Vendor {
  id        String   @id @default(cuid())
  name      String
  category  String // primary service: FUMIGATION | WASTE_MANAGEMENT | INSPECTION (legacy: WASTE | REPAIRS)
  rating    Float    @default(0)
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // ++ MONEY CORE — payout destination, verified by Flutterwave name enquiry.
  // ++ VENDORS — network jobs are paid from the property's service fund
  // (fund:{propertyId}:{SERVICE}); legacy jobs still pay from platform:revenue.
  bankName      String?
  bankCode      String?
  accountNumber String?
  accountName   String?

  // ++ VENDORS ------------------------------------------------------------------
  /// The login. Vendors are Users with role VENDOR; one user = one vendor.
  userId         String?   @unique
  kind           String    @default("COMPANY") // COMPANY | INDIVIDUAL
  providerType   String    @default("FUMIGATION_COMPANY") // VENDORS_PUBLIC.providerTypes key
  services       String[] // every service it may be matched for (primary + addable)
  contactName    String?
  email          String?
  cacNumber      String?
  /// PENDING until admin verifies documents + bank. Only VERIFIED + isActive
  /// vendors are matched or paid.
  status         String    @default("PENDING") // PENDING | VERIFIED | SUSPENDED
  verifiedAt     DateTime?
  bankVerifiedAt DateTime?
  capacityPerDay Int       @default(4)
  maxClients     Int       @default(60)
  releaseMode    String    @default("INSTANT") // INSTANT | END_OF_DAY
  updatedAt      DateTime  @default(now()) @updatedAt

  // DELETION: SetNull keeps the vendor's job + payout history when the login goes.
  user          User?               @relation("VendorUser", fields: [userId], references: [id], onDelete: SetNull)
  areas         VendorServiceArea[]
  assignments   VendorAssignment[]
  payoutBatches VendorPayoutBatch[]
  // ++ ---------------------------------------------------------------------------

  jobs ServiceJob[]

  @@index([category, isActive])
  @@index([status, isActive]) // ++ VENDORS
}

model ServicePlan {
  id              String   @id @default(cuid())
  name            String   @unique // Basic | Shield | Estate
  pricePerQuarter Decimal  @db.Decimal(10, 2)
  entitlements    Json // { fumigationPerYear, wastePickup, inspectionsPerYear }
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  subscriptions ServiceSubscription[]
}

model ServiceSubscription {
  id       String   @id @default(cuid())
  ownerId  String   @unique
  planId   String
  status   String   @default("ACTIVE") // ACTIVE | CANCELLED | EXPIRED
  renewsAt DateTime

  // Cascade — the plan is meaningless without the owner. Set to CANCELLED at
  // day 0 (reversible), deleted at erasure. The quarterly fee already paid is
  // not refunded — /refund §03, and the deletion dialog says so up front.
  owner User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan  ServicePlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ServiceJob {
  id            String    @id @default(cuid())
  propertyId    String
  vendorId      String?
  requestedById String
  serviceType   String // FUMIGATION | WASTE_MANAGEMENT | INSPECTION | REPAIR_*
  status        String    @default("REQUESTED") // REQUESTED | QUOTE_REQUESTED | SCHEDULED | RESCHEDULE_REQUESTED | ACTIVE | COMPLETED | ISSUE
  scheduledFor  DateTime?
  notes         String?
  issueReason   String?
  reportNote    String?
  cost          Decimal   @default(0) @db.Decimal(10, 2)
  photoKeys     String[]
  completedAt   DateTime?
  // ++ MONEY CORE — vendor payout (idempotency anchor = payoutRef)
  payoutRef     String?   @unique
  paidOutAt     DateTime?

  // ++ VENDORS ------------------------------------------------------------------
  // Extra status values (String column): PAUSED (plan inactive — never
  // dispatched or paid) · CANCELLED (replan/downgrade before the freeze
  // window) · MISSED (day ended without a verified code) · LOCKED (too many
  // wrong codes — admin review).
  assignmentId  String?
  planType      SubscriptionPlan? // plan that funded the visit
  windowEnd     DateTime? // scheduledFor = window start
  verifiedAt    DateTime?
  verifiedVia   String? // CODE | QR | ADMIN
  verifiedById  String? // who generated the matched code
  codeAttempts  Int       @default(0)
  payoutBatchId String?

  assignment    VendorAssignment?     @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  payoutBatch   VendorPayoutBatch?    @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)
  codes         ServiceVisitCode[]
  reminderCalls ServiceReminderCall[]
  // ++ ---------------------------------------------------------------------------

  // ++ DELETION — requestedBy Restrict: a vendor was dispatched and paid. An
  // OPEN service visit blocks the owner's deletion request outright — we
  // cannot send a technician to a property with no owner on record.
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  vendor      Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  requestedBy User     @relation("ServiceJobRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, status])
  @@index([vendorId])
  @@index([scheduledFor])
  @@index([requestedById]) // ++ DELETION
  @@index([assignmentId, status]) // ++ VENDORS
  @@index([vendorId, scheduledFor]) // ++ VENDORS
  @@index([payoutBatchId]) // ++ VENDORS
}

// ---------------------------------------------------------------------------
// ++ VENDORS — vendor network (matching, scheduling, visit codes, reminders,
// end-of-day payouts). See backend/vendor-service/VENDORS.md.
// ---------------------------------------------------------------------------

/// Where a vendor works. A property is eligible when it sits inside any of
/// the vendor's area radii (haversine from the area centre).
model VendorServiceArea {
  id        String   @id @default(cuid())
  vendorId  String
  state     String
  lga       String
  area      String
  lat       Float
  lng       Float
  radiusKm  Float
  createdAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([state, lga])
}

/// Which vendor serves which property, per service.
/// activeKey = "{propertyId}:{serviceType}" while ACTIVE/PAUSED, NULL once
/// ENDED. Its UNIQUE index makes it impossible for two vendors to hold the
/// same property for the same service.
model VendorAssignment {
  id          String           @id @default(cuid())
  propertyId  String
  ownerId     String
  vendorId    String
  serviceType String // FUMIGATION | WASTE_MANAGEMENT | INSPECTION
  /// Plan snapshot at the last (re)plan — a mismatch with the property's
  /// PropertySubscription.planType is how upgrades/downgrades are detected.
  planType    SubscriptionPlan
  status      String           @default("ACTIVE") // ACTIVE | PAUSED | ENDED
  activeKey   String?          @unique
  distanceKm  Float?
  assignedAt  DateTime         @default(now())
  pausedAt    DateTime?
  endedAt     DateTime?
  endReason   String?

  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  vendor   Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  jobs     ServiceJob[]

  @@index([vendorId, status])
  @@index([ownerId, serviceType, status])
  @@index([propertyId])
}

/// The owner's availability for visits on one property. Always inside the
/// service hours (Mon–Thu & Sat, 09:00–17:00); no row = the full hours.
model PropertyServiceWindow {
  propertyId  String   @id
  days        Int[] // 1–4, 6 (0 = Sunday)
  startMinute Int
  endMinute   Int
  updatedById String
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

/// One-time visit codes. The raw code is never stored: HMAC(jobId:code).
model ServiceVisitCode {
  id            String    @id @default(cuid())
  jobId         String
  codeHash      String
  generatedById String
  generatedRole String // OWNER | LISTING_AGENT | TENANT
  expiresAt     DateTime // end of service hours on the visit day
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  job         ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Cascade — a code is useless once its creator's account is gone.
  generatedBy User       @relation("VisitCodeGenerator", fields: [generatedById], references: [id], onDelete: Cascade)

  @@index([jobId, usedAt])
  @@index([generatedById])
}

/// Every reminder ring (fumigation + inspection), for audit and retries.
model ServiceReminderCall {
  id             String    @id @default(cuid())
  jobId          String
  dayOffset      Int // 2 = two days before, 0 = visit day
  contactRole    String // TENANT | LISTING_AGENT | OWNER
  userId         String?
  phoneE164      String
  attempt        Int       @default(1)
  status         String    @default("RINGING") // RINGING | ANSWERED | NO_ANSWER | FAILED
  provider       String
  providerCallId String?   @unique
  answeredAt     DateTime?
  createdAt      DateTime  @default(now())

  job ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, dayOffset])
}

/// END_OF_DAY vendors get ONE transfer per day (one Flutterwave fee).
model VendorPayoutBatch {
  id         String    @id @default(cuid())
  vendorId   String
  reference  String    @unique // NC-VB-…
  amountKobo BigInt
  jobCount   Int
  status     String    @default("SENT") // SENT | SETTLED | FAILED
  createdAt  DateTime  @default(now())
  settledAt  DateTime?

  vendor Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  jobs   ServiceJob[]

  @@index([vendorId, createdAt])
}

// ---------------------------------------------------------------------------
// Virtual Account System (unchanged)
// ---------------------------------------------------------------------------
model VirtualAccount {
  id            String  @id @default(cuid())
  accountNumber String  @unique
  accountName   String
  bankCode      String
  userId        String
  propertyId    String? @unique

  balance  Decimal @default(0) @db.Decimal(15, 2)
  currency String  @default("NGN")
  isActive Boolean @default(true)

  flutterwaveAccountId String? @unique

  // ++ DELETION — Restrict. A VA can hold a balance; deleting the user out from
  // under one would strand money. Any balance > 0 blocks the request; at
  // erasure the account is set isActive: false, and zero-balance rows are
  // deleted at the 18-month purge.
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([accountNumber])
}

model Referral {
  id         String @id @default(cuid())
  referrerId String
  referredId String @unique

  referralCode String
  referralType ReferralType?
  isActive     Boolean       @default(true)

  status           ReferralStatus @default(PENDING)
  qualificationMet Boolean        @default(false)
  qualifiedAt      DateTime?

  reward         Decimal?    @db.Decimal(10, 2)
  referrerReward Decimal?    @db.Decimal(10, 2)
  referredReward Decimal?    @db.Decimal(10, 2)
  rewardType     RewardType? @default(SERVICE_CREDIT)

  rewardPaid           Boolean   @default(false)
  referrerRewardPaid   Boolean   @default(false)
  referredRewardPaid   Boolean   @default(false)
  referrerRewardPaidAt DateTime?
  referredRewardPaidAt DateTime?

  clickCount   Int     @default(0)
  shareChannel String?

  // ++ REFERRALS v2 (spec §9). Column names kept (referredId, referralCode) so
  // account-deletion and existing readers keep compiling; the engine maps
  // referredId → refereeId.
  source       String? // LINK | CODE_ENTRY | INVITE
  activatedAt  DateTime?
  fraudHold    Boolean   @default(false)
  fraudReason  String?
  signupIpHash String?
  deviceHash   String?

  // ++ DELETION — Restrict on both sides so paid-out reward history is never
  // silently destroyed. Cleared explicitly at the 18-month purge, and only for
  // an account that touched nothing else.
  referrer User             @relation("Referrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referred User             @relation("Referred", fields: [referredId], references: [id], onDelete: Restrict)
  rewards  ReferralReward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId])
  @@index([referralCode])
  @@index([status])
  @@index([qualificationMet])
  @@index([referralType])
}

model EventLog {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  metadata  Json?
  timestamp DateTime @default(now())
  ipAddress String?
  userAgent String?

  // ++ DELETION — SetNull. /privacy §12 promises activity logs are "summarized
  // into de-identified statistical data", not destroyed. Erasure nulls userId,
  // ipAddress and userAgent, keeping the analytics and dropping the person.
  user User? @relation("UserEvents", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([timestamp])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     Boolean
  context   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

model OTPCode {
  id          String   @id @default(cuid())
  identifier  String
  code        String
  type        OTPType
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  verified    Boolean  @default(false)
  expiresAt   DateTime

  createdAt DateTime @default(now())

  // NOTE: keyed by identifier (email/phone), NOT userId — so there is no FK to
  // cascade. Erasure deletes by identifier before the email is tombstoned.
  @@unique([identifier, type], name: "identifier_type")
  @@index([expiresAt])
}

enum OTPType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  LOGIN
  BANK_ACCOUNT_CHANGE // ++ ADDED — OTP gate on adding/changing a payout account
}

model SupportTicket {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String
  category    TicketCategory
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)

  adminResponse String?
  resolvedBy    String?
  resolvedAt    DateTime?

  // ++ DELETION — Restrict. Support history can be evidence in a dispute. The
  // row survives; because there is no email/phone column, the personal data
  // lives in the free-text title and description, which erasure REDACTS.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
