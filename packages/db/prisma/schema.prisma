// All subscription plan variants across all three user types
enum SubscriptionPlan {
  // Landlord / Property Owner plans
  OWNER_ESSENTIAL          // ₦7,500/mo — up to 2 properties, 20% commission
  OWNER_ELITE              // ₦18,500/mo — unlimited properties, 15% commission

  // Agent plans (Founding Agent Program — first 100)
  AGENT_ESSENTIAL          // Lower tier — paid only
  AGENT_PREMIUM            // Higher tier — marking jobs access, sub-agent tools

  // Renter plans
  // RENTER_FREE is the default for ALL renters right now — no card, no expiry, no charge.
  // RENTER_PREMIUM_PLUS is free for the first 300 founding renters.
  // Both will become paid (₦1,500/mo and ₦3,500/mo) when renterPaidPlanUnlockedAt is set.
  RENTER_FREE              // Free forever base plan — browse, pay, refund window, all included
  RENTER_PREMIUM_PLUS      // Free now for founding 300 → ₦3,500/mo when paid billing launches

  // Annual variants — owners and agents only for now (renters don't have annual billing yet)
  OWNER_ESSENTIAL_ANNUAL
  OWNER_ELITE_ANNUAL
  AGENT_ESSENTIAL_ANNUAL
  AGENT_PREMIUM_ANNUAL
  // RENTER_PREMIUM_PLUS_ANNUAL — add this when paid renter billing launches
}

enum SubscriptionStatus {
  PENDING          // Payment initiated but not yet confirmed
  FREE_ACTIVE      // On a free plan — no payment required, no expiry date
                   // Used for: RENTER_FREE and founding RENTER_PREMIUM_PLUS
                   // Renewal cron ignores FREE_ACTIVE records entirely
  ACTIVE           // Paid subscription in good standing (owners and agents only, for now)
  TRIAL            // On a free trial (future use)
  PAST_DUE         // Renewal payment failed — grace period active
  CANCELLED        // User cancelled — access until period end
  EXPIRED          // Period ended with no renewal
  PAUSED           // Temporarily paused (future feature)
  SUSPENDED        // Admin-suspended (e.g. policy violation)
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionEvent {
  CREATED              // First subscription created
  ACTIVATED            // Payment confirmed — subscription went ACTIVE
  RENEWED              // Successful renewal charge
  RENEWAL_FAILED       // Renewal charge failed
  RENEWAL_RETRIED      // Retry attempt after failure
  UPGRADED             // Moved to a higher plan (e.g. Essential → Elite)
  DOWNGRADED           // Moved to a lower plan
  CANCELLED            // User cancelled
  EXPIRED              // Naturally expired without renewal
  REACTIVATED          // Cancelled/expired user re-subscribed
  PAUSED               // Subscription paused
  RESUMED              // Subscription resumed from pause
  SUSPENDED            // Admin suspended
  TRIAL_STARTED        // Trial began
  TRIAL_ENDED          // Trial ended (converted or expired)
  VIRTUAL_ACCOUNT_CREATED  // For Premium renters — VA created after activation
  PLAN_CHANGED         // General plan change event
  FREE_PLAN_CONVERTED  // Founding renter converted from free → paid billing
                       // Fired when renterPaidPlanUnlockedAt is set and first charge runs
  FREE_ACCESS_GRANTED  // A free plan was granted (new renter signup, or admin grant)
}

enum InvoiceStatus {
  PENDING      // Awaiting payment
  PAID         // Successfully charged
  FAILED       // Charge failed
  REFUNDED     // Invoice amount refunded
  VOID         // Cancelled before payment
}


// ============================================================================
// ENFORCEMENT LOGIC — Notes for your backend service layer
// ============================================================================
//
// 1. RENTER SIGNUP (current behaviour — free):
//    When a new RENTER registers:
//    → Create a Subscription record with:
//        planType     = RENTER_FREE  (or RENTER_PREMIUM_PLUS if within first 300)
//        status       = FREE_ACTIVE
//        isFreeRenterPlan = true
//        billingCycle = MONTHLY (doesn't matter yet — no charge runs)
//        amountNaira  = 0
//        finalAmountNaira = 0
//        currentPeriodStart = now()
//        currentPeriodEnd   = null  ← no expiry on free plans
//    → For founding 300: set isFoundingMember = true, foundingMemberNumber = <next available>
//    → Log FREE_ACCESS_GRANTED event in SubscriptionHistory
//    → No Flutterwave interaction at all
//
// 2. RENTER PREMIUM PLUS — free for founding 300:
//    → Same as above but planType = RENTER_PREMIUM_PLUS
//    → canAccessMarkingJobs = false  (Premium Plus renters get this when paid billing launches)
//    → lockedRateNaira = 3500  ← stored now, charged later
//    → Virtual account: create immediately on signup (they're Premium Plus, even if free)
//    → Log VIRTUAL_ACCOUNT_CREATED in SubscriptionHistory
//
// 3. FLIPPING RENTERS TO PAID BILLING (future — one admin action):
//    When you're ready to charge renters:
//    → Run a migration script that sets renterPaidPlanUnlockedAt = NOW() on all
//      renter subscriptions where status = FREE_ACTIVE
//    → The renewal cron will pick them up on next run
//    → Founding renters: charge lockedRateNaira (never the current plan price)
//    → Non-founding renters: charge current planType price (₦3,500 for Premium Plus)
//    → Status transitions: FREE_ACTIVE → PENDING → ACTIVE (on successful charge)
//    → Log FREE_PLAN_CONVERTED event in SubscriptionHistory
//    → No schema migration needed — the fields are already there
//
// 4. PROPERTY CAP (Landlord Essential):
//    Before allowing a new property listing:
//    → Check subscription.planType === OWNER_ESSENTIAL
//    → If yes, check subscription.currentPropertyCount >= subscription.propertyListingCap (2)
//    → If capped: return 403 with upgrade prompt
//    → Increment currentPropertyCount on each new listing, decrement on deletion
//
// 5. COMMISSION RATE:
//    When calculating rent commission:
//    → OWNER_ELITE / OWNER_ELITE_ANNUAL → 15% platform commission
//    → All other owner plans or no subscription → 20% platform commission
//
// 6. MARKING JOB ACCESS:
//    Before allowing a user to accept/request marking jobs:
//    → Check subscription.canAccessMarkingJobs === true
//    → Currently set to true for: AGENT_PREMIUM only
//    → RENTER_PREMIUM_PLUS gets canAccessMarkingJobs = true when paid billing launches
//
// 7. VIRTUAL ACCOUNT CREATION:
//    → RENTER_PREMIUM_PLUS (even free): create VA on signup
//    → OWNER / AGENT: create VA on account creation (already in your schema)
//    → RENTER_FREE: no VA (they use the platform payment flow without a personal VA)
//
// 8. RENEWAL JOB (cron) — owners and agents only for now:
//    → Query: WHERE status = ACTIVE AND currentPeriodEnd <= NOW() + 3 days
//             AND isFreeRenterPlan = false   ← CRITICAL: skip all free renter records
//    → Attempt charge via Flutterwave using flwCustomerToken
//    → On success: extend currentPeriodEnd, log RENEWED event, create new invoice
//    → On failure: set status = PAST_DUE, increment renewalFailureCount, schedule retry
//    → After 3 failed retries: set status = EXPIRED, log EXPIRED event
//
// 9. FOUNDING AGENT COHORT:
//    → First 100 agents on AGENT_PREMIUM: isFoundingAgent = true, foundingAgentNumber = <next>
//    → Per your frontend data: founding Premium agents get it "free for life"
//    → Implement as: isFreeRenterPlan = false (agents are paid) BUT you manually credit
//      their subscription or set a special flag — handle this via admin action or
//      a foundingAgentFreeForLife Boolean field if you need hard enforcement
//
// ============================================================================

