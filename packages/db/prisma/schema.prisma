// ============================================================================
// MONEY CORE — one central account, an internal double-entry ledger.
//
// Every naira that enters Newcondo lands in ONE place: Flutterwave settles card
// / transfer charges into the merchant balance, and the business static account
// (MONEY.centralAccount) receives direct bank transfers into the same balance.
// "Who owns what" inside that pool is answered by this ledger, never by
// Flutterwave. When per-user virtual accounts are enabled, they become extra
// COLLECTION rails that post into the same ledger — nothing here changes.
//
// Invariants (enforced in backend/shared/src/money/ledger.ts):
//   • every LedgerTransaction's entries sum to exactly 0 kobo
//   • idempotencyKey is unique — a retried webhook/cron posts nothing twice
//   • non-WORLD accounts can never go negative (conditional update in-txn)
//   • Σ(all non-WORLD balances) = −balance(world:flutterwave) = cash we hold
// ============================================================================

enum LedgerAccountKind {
  WORLD // the outside world via Flutterwave (cash in / cash out)
  PLATFORM // Newcondo's own earned money
  ESCROW // held for a confirmation window (rent 24h, marking fees)
  TRANSIT // payouts initiated, not yet confirmed by the bank
  SUSPENSE // inbound transfers we could not match to anything yet
  USER_AVAILABLE // withdrawable
  USER_PENDING // credited but locked (e.g. marking hold until owner confirms)
  SERVICE_FUND // ++ VENDORS — fund:{propertyId}:{SERVICE}, vendor-cost share of a plan
}

model LedgerAccount {
  id            String            @id @default(cuid())
  /// "user:{id}:available", "platform:revenue", "escrow:rent", …
  code          String            @unique
  kind          LedgerAccountKind
  userId        String?
  currency      String            @default("NGN")
  /// Running balance maintained in the SAME transaction as each entry, so a
  /// debit can be made conditional (balance >= amount) without a race.
  /// The nightly reconciler recomputes it from entries and alerts on drift.
  balanceKobo   BigInt            @default(0)
  allowNegative Boolean           @default(false)

  // Restrict — an account with history is a financial record.
  user    User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([kind])
}

enum LedgerTxnType {
  OPENING_BALANCE
  RENT_COLLECTED
  RENT_RELEASED
  RENT_REFUNDED
  SUBSCRIPTION_COLLECTED
  PROPERTY_PLAN_COLLECTED
  MARKING_FEE_COLLECTED
  MARKING_HOLD
  MARKING_RELEASED
  MARKING_REFUNDED
  VENDOR_PAYOUT
  WITHDRAWAL_INITIATED
  WITHDRAWAL_SETTLED
  WITHDRAWAL_REVERSED
  REFERRAL_OVERRIDE
  INBOUND_TRANSFER
  INBOUND_MATCHED
  ADJUSTMENT
  SERVICE_FUND_ACCRUED // ++ VENDORS — revenue → service fund, per paid period
  SERVICE_FUND_RETURNED // ++ VENDORS — service fund → revenue, downgrade/lapse leftover
}

model LedgerTransaction {
  id             String        @id @default(cuid())
  idempotencyKey String        @unique
  type           LedgerTxnType
  sourceType     String // PAYMENT | INVOICE | MARKING_JOB | SERVICE_JOB | INBOUND | REFERRAL | ADMIN
  sourceId       String
  paymentId      String?
  memo           String?
  metadata       Json?
  createdBy      String? // "system" | admin user id
  entries        LedgerEntry[]
  createdAt      DateTime      @default(now())

  @@index([sourceType, sourceId])
  @@index([type, createdAt])
  @@index([paymentId])
}

model LedgerEntry {
  id            String @id @default(cuid())
  transactionId String
  accountId     String
  /// Signed. +credit to the account, −debit. Σ per transaction = 0.
  amountKobo    BigInt

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([transactionId])
}

enum InboundTransferStatus {
  UNMATCHED
  MATCHED
  REFUNDED
  IGNORED
}

/// A bank transfer INTO the central account (or, later, a per-user VA).
/// Matched by the NC-… reference the payer was told to put in the narration;
/// anything unmatched sits in suspense until an admin resolves it.
model InboundTransfer {
  id               String                @id @default(cuid())
  flwTransactionId String                @unique
  accountNumber    String
  amountKobo       BigInt
  senderName       String?
  senderAccount    String?
  senderBank       String?
  narration        String?
  reference        String?
  status           InboundTransferStatus @default(UNMATCHED)
  matchedPaymentId String?
  matchedAt        DateTime?
  resolvedBy       String?
  raw              Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([reference])
}

enum PropertyPlanStatus {
  PENDING_PAYMENT
  ACTIVE
  CANCELLED
}

// ============================================================================
// REFERRALS v2 — config-driven, margin-funded (spec §9).
// Existing Referral is extended in place (see above); ReferralReward is kept
// for history only — the engine writes ReferralLedgerEntry.
// No User relations on these on purpose: they are audit rows keyed by id, and
// account deletion must not cascade into them.
// ============================================================================

enum ReferralLedgerKind {
  SUBSCRIPTION_CREDIT
  SERVICE_CREDIT
  COMMISSION_OVERRIDE
  CLAWBACK
}

enum ReferralLedgerStatus {
  SCHEDULED
  AVAILABLE
  PENDING_FUNDING
  REDEEMED
  PARTIALLY_REDEEMED
  PAID_OUT
  EXPIRED
  VOIDED
}

enum ReferralEventOutcome {
  REWARDED
  SKIPPED
}

model ReferralLinkClick {
  id         String   @id @default(cuid())
  referrerId String
  code       String
  ipHash     String?
  deviceHash String?
  createdAt  DateTime @default(now())

  @@index([referrerId, createdAt])
  @@index([code, createdAt])
}

model ReferralCohortMember {
  id       String   @id @default(cuid())
  cohort   String // CohortId
  userId   String
  joinedAt DateTime @default(now())

  @@unique([cohort, userId])
  @@index([cohort, joinedAt])
}

model ReferralEvent {
  id            String               @id @default(cuid())
  sourceType    String
  sourceId      String
  ruleId        String
  referralId    String
  beneficiaryId String?
  outcome       ReferralEventOutcome
  skipReason    String?
  marginKobo    BigInt?
  /// The normalised BusinessEvent. Lets an admin "clear fraud hold" replay
  /// exactly what was skipped instead of guessing.
  payload       Json?
  createdAt     DateTime             @default(now())

  @@unique([sourceType, sourceId, ruleId, referralId])
  @@index([ruleId, createdAt])
  @@index([referralId])
}

model ReferralLedgerEntry {
  id           String               @id @default(cuid())
  userId       String
  referralId   String
  ruleId       String
  sourceType   String
  sourceId     String
  kind         ReferralLedgerKind
  status       ReferralLedgerStatus
  amountKobo   BigInt
  redeemedKobo BigInt               @default(0)
  serviceType  String?
  serviceRef   String?
  availableAt  DateTime
  expiresAt    DateTime?
  voidedAt     DateTime?
  voidReason   String?
  redemptions  ReferralRedemption[]
  createdAt    DateTime             @default(now())

  @@unique([sourceType, sourceId, ruleId, userId])
  @@index([userId, status, expiresAt])
  @@index([ruleId, createdAt])
  @@index([referralId])
  @@index([status, availableAt])
}

model ReferralRedemption {
  id            String              @id @default(cuid())
  ledgerEntryId String
  invoiceId     String?
  amountKobo    BigInt
  status        String // RESERVED | CONFIRMED | RELEASED
  ledgerEntry   ReferralLedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now())

  @@index([invoiceId])
  @@index([ledgerEntryId])
}
