// ============================================================================
// packages/db/prisma/schema.prisma — MERGED (your schema + dashboard features)
// ============================================================================
// Nothing was removed from your schema. Additions are marked  // ++ ADDED
// Reused instead of duplicated:
//   • Referral / ReferralReward   → user referral credits (no new Referral model)
//   • AgentReferral (+Click/Conversion) → sub-agent promo tracking analytics
//   • PromotionRequest / PropertyPromotionSettings → sub-agent approval flow
//   • PropertyMarkingJob          → marking jobs (extended, not replaced)
//   • Property.boundary*          → the verified mark (no separate PropertyMark)
//   • VirtualAccount              → escrow accounts (user + per-property)
//   • Document                    → S3 identity/ownership docs
// Then run: npx prisma migrate dev --name dashboard_features
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  phone         String?   @unique
  emailVerified DateTime?
  phoneVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(RENTER)
  userType      UserType?

  subscription         Subscription?
  subscriptionHistory  SubscriptionHistory[]
  subscriptionInvoices SubscriptionInvoice[]

  // Verification fields
  verificationStatus          VerificationStatus @default(PENDING)
  verificationRejectionReason String?
  verifiedAt                  DateTime?
  verifiedBy                  String?

  // Profile fields
  dateOfBirth DateTime?
  address     String?
  city        String?
  state       String?
  country     String?   @default("Nigeria")

  // ++ ADDED — BVN powers Flutterwave permanent virtual-account creation for
  // renters at checkout (escrow safety + compliance). Encrypt at rest.
  bvn String?

  // ++ ADDED — payout automation for owners/agents: OFF | INSTANT | WEEKLY | MONTHLY
  autoPayoutMode String @default("OFF")

  // B2B specific fields for property managers
  companyName       String?
  businessRegNumber String?
  isB2BCustomer     Boolean @default(false)

  // Premium status
  isPremium        Boolean   @default(false)
  premiumExpiresAt DateTime?

  // Referral tracking — also used as the unique code inside share/promo URLs
  referralCode String @unique @default(cuid())

  // Agent specific fields
  isAvailableForMarking Boolean  @default(false)
  agentServiceAreas     String[]
  agentReliabilityScore Decimal? @db.Decimal(3, 2)
  totalMarkingJobs      Int      @default(0)
  completedMarkingJobs  Int      @default(0)

  // Relations
  accounts      Account[]
  sessions      Session[]
  properties    Property[] @relation("PropertyOwner")
  agentListings Property[] @relation("PropertyAgent")

  // User Referral System
  referrals  Referral[]       @relation("Referrer")
  referredBy Referral?        @relation("Referred")
  rewards    ReferralReward[] @relation("UserRewards")

  // Agent Referral System
  agentReferrals     AgentReferral[]    @relation("AgentReferrals")
  promotionRequests  PromotionRequest[] @relation("PromotionRequester")
  ownedPromotionReqs PromotionRequest[] @relation("PromotionOwner")

  authenticator        Authenticator[]
  featureFlags         FeatureFlag[]
  events               EventLog[]           @relation("UserEvents")
  payments             Payment[]
  rentals              Rental[]
  virtualAccounts      VirtualAccount[]
  assignedMarkingJobs  PropertyMarkingJob[] @relation("AssignedAgent")
  requestedMarkingJobs PropertyMarkingJob[] @relation("RequestingUser")
  supportTickets       SupportTicket[]
  adminActions         AdminAction[]
  refreshToken         RefreshToken[]
  documents            Document[]

  // ++ ADDED relations
  notifications        Notification[]
  bankAccounts         BankAccount[]
  shareLinks           ShareLink[]           @relation("ShareLinkCreator")
  sentTenantInvites    TenantInvite[]        @relation("TenantInviteSender")
  usedTenantInvites    TenantInvite[]        @relation("TenantInviteRenter")
  sentAgentInvites     AgentInvite[]         @relation("AgentInviteOwner")
  linksAsOwner         OwnerAgentLink[]      @relation("OwnerAgentLinkOwner")
  linksAsAgent         OwnerAgentLink[]      @relation("OwnerAgentLinkAgent")
  markingQueueEntries  MarkingQueueEntry[]   @relation("MarkingQueueAgent")
  subAgentPayments     Payment[]             @relation("PaymentSubAgent")
  invitedRentals       Rental[]              @relation("RentalInviter")
  serviceSubscription  ServiceSubscription?
  requestedServiceJobs ServiceJob[]          @relation("ServiceJobRequester")

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  disputes           Dispute[]
  disputeComments    DisputeComment[]
  disputeEvidences   DisputeEvidence[]
  paymentAttemptLogs PaymentAttemptLog[]

  @@index([email])
  @@index([phone])
  @@index([verificationStatus])
  @@index([role])
  @@index([userType])
  @@index([isAvailableForMarking])
  @@index([referralCode])
}

enum Role {
  OWNER
  AGENT
  RENTER
  ADMIN
}

enum IdDocumentType {
  NIN
  BVN
  PASSPORT
  VOTERS_CARD
  DRIVERS_LICENSE
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Document {
  id         String  @id @default(cuid())
  userId     String
  propertyId String?

  documentType DocumentType
  documentSide DocumentSide?
  pageNumber   Int?

  documentNumber String?

  fileName      String?
  fileUrl       String? // CloudFront URL or presigned URL
  s3Key         String? // raw S3 key e.g. "users/clx8j/identity/nin/front_uuid.jpg"
  fileSizeBytes Int?
  mimeType      String?

  status            DocumentStatus @default(PENDING)
  verificationNotes String?

  isRequired Boolean   @default(true)
  expiresAt  DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, documentType, documentSide, pageNumber, propertyId], name: "unique_document_variant")
  @@index([userId])
  @@index([propertyId])
  @@index([documentType])
  @@index([status])
  @@index([documentNumber])
}

enum DocumentSide {
  FRONT
  BACK
  SINGLE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Property {
  id          String @id @default(cuid())
  title       String
  description String

  structure PropertyStructure @default(SINGLE_UNIT)

  price    Decimal? @db.Decimal(10, 2)
  currency String   @default("NGN")

  // Location
  address        String
  city           String
  state          String
  country        String  @default("Nigeria")
  gpsCoordinates String?

  // Property Boundary Information — this IS the verified "mark"
  boundaryCoordinates Json?
  boundaryVerified    Boolean   @default(false)
  boundaryMarkedBy    String?
  boundaryMarkedAt    DateTime?
  boundaryImages      String[]
  buildingFingerprint String?

  // ++ ADDED — S3 key of the AI-segmented green mask PNG, re-drawn as the
  // coloured overlay whenever the map loads (marking segmentation pipeline).
  boundaryMaskImageKey String?

  // Building-level details (multi-family)
  totalUnits       Int?
  availableUnits   Int?
  buildingFeatures String[]

  // Property details (single units)
  propertyType PropertyType @default(APARTMENT)
  bedrooms     Int?
  bathrooms    Int?
  area         String?
  features     String[]

  // Ownership & Agency
  ownerId        String
  agentId        String?
  isOwnerListing Boolean @default(true)

  images PropertyImage[]

  // Status & Approval
  status              PropertyStatus      @default(DRAFT)
  adminApprovalStatus AdminApprovalStatus @default(PENDING)
  rejectionReason     String?
  approvedAt          DateTime?
  approvedBy          String?

  // Rental & Availability (single units)
  isAvailable       Boolean   @default(true)
  availableFrom     DateTime?
  isPaymentLocked   Boolean   @default(false)
  paymentLockExpiry DateTime?

  // Sharing & Marketing
  shareableLink String? @unique
  viewCount     Int     @default(0)
  favoriteCount Int     @default(0)

  owner User  @relation("PropertyOwner", fields: [ownerId], references: [id])
  agent User? @relation("PropertyAgent", fields: [agentId], references: [id])

  units PropertyUnit[]

  rentals          Rental[]
  duplicateReports PropertyDuplicate[]
  markingJobs      PropertyMarkingJob[]
  virtualAccount   VirtualAccount?
  documents        Document[]

  agentReferrals    AgentReferral[]            @relation("PropertyReferrals")
  promotionRequests PromotionRequest[]         @relation("PromotionRequests")
  promotionSettings PropertyPromotionSettings?

  // ++ ADDED relations
  shareLinks    ShareLink[]
  tenantInvites TenantInvite[]
  serviceJobs   ServiceJob[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  paymentAttemptLogs PaymentAttemptLog[]

  @@index([ownerId])
  @@index([agentId])
  @@index([status])
  @@index([adminApprovalStatus])
  @@index([city, state])
  @@index([propertyType])
  @@index([price])
  @@index([isAvailable])
  @@index([buildingFingerprint])
  @@index([boundaryVerified])
  @@index([structure])
  @@index([totalUnits])
  @@index([availableUnits])
}

model PropertyUnit {
  id         String @id @default(cuid())
  propertyId String

  unitNumber String
  floor      Int?

  bedrooms  Int?
  bathrooms Int?
  area      String?
  features  String[]

  price    Decimal @db.Decimal(10, 2)
  currency String  @default("NGN")

  status        UnitStatus @default(AVAILABLE)
  isAvailable   Boolean    @default(true)
  availableFrom DateTime?

  isPaymentLocked   Boolean   @default(false)
  paymentLockExpiry DateTime?

  images PropertyUnitImage[]

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentals  Rental[]

  // ++ ADDED — invites can be scoped to one flat
  tenantInvites TenantInvite[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  paymentAttemptLogs PaymentAttemptLog[]

  @@unique([propertyId, unitNumber], name: "unique_unit_per_property")
  @@index([propertyId])
  @@index([status])
  @@index([isAvailable])
  @@index([price])
  @@index([bedrooms])
  @@index([floor])
}

model PaymentAttemptLog {
  id            String   @id @default(cuid())
  userId        String
  propertyId    String
  unitId        String?
  amount        Decimal  @db.Decimal(10, 2)
  status        String
  failureReason String?
  lockAcquired  Boolean  @default(false)
  lockDuration  Int?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id])
  property Property      @relation(fields: [propertyId], references: [id])
  unit     PropertyUnit? @relation(fields: [unitId], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@index([createdAt])
}

model PropertyUnitImage {
  id        String  @id @default(cuid())
  unitId    String
  url       String
  altText   String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)

  unit PropertyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([unitId])
  @@index([isPrimary])
}

enum PropertyType {
  APARTMENT
  HOUSE
  DUPLEX
  ROOM
  SHARED_APARTMENT
  OFFICE
  SHOP
  WAREHOUSE
}

enum PropertyStatus {
  DRAFT
  PENDING
  PUBLISHED
  RENTED
  UNAVAILABLE
}

enum PropertyStructure {
  SINGLE_UNIT
  MULTI_FAMILY
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
  UNDER_CONSTRUCTION // ++ ADDED — dashboard shows per-flat "Under construction"
}

enum AdminApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserType {
  OWNER
  PROPERTY_MANAGER
  AGENT
  RENTER
  ADMIN
}

enum DocumentType {
  NIN
  BVN
  PASSPORT
  VOTERS_CARD
  DRIVERS_LICENSE
  SELFIE
  OWNERSHIP_DOCUMENT
  CONSENT_DOCUMENT
  UNDERTAKING_DOCUMENT
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  UTILITY_BILL
  BANK_STATEMENT
  OTHER
}

model PropertyImage {
  id         String  @id @default(cuid())
  propertyId String
  url        String
  altText    String?
  isPrimary  Boolean @default(false)
  order      Int     @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([propertyId])
}

model PropertyDuplicate {
  id                  String          @id @default(cuid())
  originalPropertyId  String
  duplicatePropertyId String
  reportedBy          String?
  status              DuplicateStatus @default(PENDING)
  resolution          String?
  resolvedBy          String?
  resolvedAt          DateTime?

  originalProperty Property @relation(fields: [originalPropertyId], references: [id])

  createdAt DateTime @default(now())

  @@index([originalPropertyId])
  @@index([duplicatePropertyId])
  @@index([status])
}

enum DuplicateStatus {
  PENDING
  CONFIRMED_DUPLICATE
  NOT_DUPLICATE
  RESOLVED
}

// ---------------------------------------------------------------------------
// Property Marking Service — EXTENDED (not replaced)
// ---------------------------------------------------------------------------
model PropertyMarkingJob {
  id              String  @id @default(cuid())
  propertyId      String
  requestedBy     String
  assignedAgentId String?

  contactPersonName  String
  contactPersonPhone String
  accessInstructions String?
  preferredTime      DateTime?
  urgencyLevel       UrgencyLevel @default(NORMAL)

  markingFee    Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)

  status         MarkingJobStatus @default(QUEUED)
  assignedAt     DateTime?
  completedAt    DateTime?
  timeSlotExpiry DateTime?

  completionNotes  String?
  completionImages String[]
  boundaryData     Json?

  queuePosition     Int?
  maxCompletionTime DateTime?

  // ++ ADDED — how the owner/agent chose to get it marked
  method MarkingMethod @default(BROADCAST)

  // ++ ADDED — 72h owner confirmation window; payout drips if it lapses
  confirmDeadline DateTime?
  confirmedAt     DateTime?
  disputeReason   String?

  // ++ ADDED — S3 keys: satellite snapshot + AI green-mask (segmentation)
  snapshotImageKey String?
  maskImageKey     String?

  property       Property @relation(fields: [propertyId], references: [id])
  requestingUser User     @relation("RequestingUser", fields: [requestedBy], references: [id])
  assignedAgent  User?    @relation("AssignedAgent", fields: [assignedAgentId], references: [id])

  // ++ ADDED — FCFS queue rows (3-hour slot per agent)
  queueEntries MarkingQueueEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([requestedBy])
  @@index([assignedAgentId])
  @@index([status])
  @@index([queuePosition])
}

// ++ ADDED — one row per agent who joined a broadcast job's queue
model MarkingQueueEntry {
  id            String    @id @default(cuid())
  jobId         String
  agentId       String
  position      Int
  slotStartedAt DateTime?
  completedAt   DateTime?
  abandonedAt   DateTime?
  createdAt     DateTime  @default(now())

  job   PropertyMarkingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agent User               @relation("MarkingQueueAgent", fields: [agentId], references: [id])

  @@unique([jobId, agentId])
  @@index([jobId, position])
  @@index([agentId])
}

// ++ ADDED
enum MarkingMethod {
  SELF
  KNOWN_PERSON
  BROADCAST
  NEWCONDO
}

enum MarkingJobStatus {
  QUEUED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  AWAITING_CONFIRMATION // ++ ADDED — marked, waiting on the owner (72h)
  DISPUTED              // ++ ADDED — owner disputed the boundary
}

enum UrgencyLevel {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Rental {
  id          String       @id @default(cuid())
  propertyId  String
  unitId      String?
  renterId    String
  startDate   DateTime
  endDate     DateTime?
  monthlyRent Decimal      @db.Decimal(10, 2)
  status      RentalStatus @default(ACTIVE)
  disputes    Dispute[]

  confirmationDeadline DateTime?
  isConfirmed          Boolean   @default(false)
  confirmedAt          DateTime?

  // ++ ADDED — set when the tenancy came from a tenant-invite link; surfaces
  // the tenant in the inviting owner's/agent's dashboard.
  invitedById String?

  property Property      @relation(fields: [propertyId], references: [id])
  unit     PropertyUnit? @relation(fields: [unitId], references: [id])
  renter   User          @relation(fields: [renterId], references: [id])
  invitedBy User?        @relation("RentalInviter", fields: [invitedById], references: [id]) // ++ ADDED
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([unitId])
  @@index([renterId])
  @@index([status])
  @@index([confirmationDeadline])
  @@index([invitedById])
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  rentalId     String?
  markingJobId String?
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("NGN")
  dispute      Dispute?

  paymentType   PaymentType
  status        PaymentStatus @default(PENDING)
  paymentMethod String?

  flutterwaveRef String? @unique
  transactionId  String? @unique

  agentCommission Decimal? @db.Decimal(10, 2)
  platformFee     Decimal? @db.Decimal(10, 2)
  ownerAmount     Decimal? @db.Decimal(10, 2)

  confirmationPeriodEnd DateTime?
  isReleased            Boolean   @default(false)
  releasedAt            DateTime?

  description   String?
  failureReason String?
  paidAt        DateTime?

  // ++ ADDED — commission attribution. Pinned from the PROMO ShareLink used at
  // checkout; the ONLY source releaseEscrowAndSplit() reads, so a sub-agent's
  // cut can never be credited to the wrong person.
  subAgentId String?

  // ++ ADDED — idempotency flag for the escrow-release split
  commissionSettledAt DateTime?

  // ++ ADDED — S3 key of the cached branded PDF receipt (receipts/…)
  receiptKey String?

  // ++ ADDED — job params for webhook-driven flows (e.g. marking-fee payment
  // carries { propertyId, method, contactName, contactPhone, accessNotes })
  meta Json?

  user     User  @relation(fields: [userId], references: [id])
  rental   Rental? @relation(fields: [rentalId], references: [id])
  subAgent User? @relation("PaymentSubAgent", fields: [subAgentId], references: [id]) // ++ ADDED

  agentReferralConversion AgentReferralConversion?

  // ++ ADDED
  platformRevenue PlatformRevenue?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  referralConversion ReferralConversion?

  @@index([userId])
  @@index([rentalId])
  @@index([markingJobId])
  @@index([status])
  @@index([paymentType])
  @@index([confirmationPeriodEnd])
  @@index([subAgentId])
}

enum PaymentType {
  RENT
  DEPOSIT
  AGENT_COMMISSION
  PREMIUM_UPGRADE
  PROPERTY_MARKING
  RENT_RELEASE  // ++ ADDED — owner's net payout row at escrow release
  WITHDRAWAL    // ++ ADDED — wallet → bank transfer
  SERVICE_FEE   // ++ ADDED — vendor repair charged to the owner
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  HELD
  RELEASED
}

// ++ ADDED — Newcondo's own commission cut, per settled payment
model PlatformRevenue {
  id        String   @id @default(cuid())
  paymentId String   @unique
  amount    Decimal  @db.Decimal(15, 2)
  source    String // RENT_COMMISSION | MARKING_FEE_MARGIN | SUBSCRIPTION
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([source, createdAt])
}

// ++ ADDED — user payout bank accounts. DISTINCT from VirtualAccount:
// VAs are auto-created by Newcondo (main + one per marked property);
// BankAccounts are user-managed withdrawal destinations.
model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  bankName      String
  bankCode      String
  accountNumber String
  accountName   String // registered holder from Flutterwave name enquiry
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNumber])
  @@index([userId])
  @@index([isDefault])
}

// ++ ADDED — persisted notifications (badge counts + history). Written by
// backend-shared publishNotification(); delivered live over Redis → SSE.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  kind       String // marking | payment | wallet | verify | tenant | service | referral
  title      String
  body       String
  to         String // dashboard route the notification deep-links to
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ++ ADDED — share & promo links. The creator's referralCode is IN the URL
// ("{code}-{suffix}") and the full code is unique, so every click and payment
// is attributable to exactly one creator.
model ShareLink {
  code       String   @id // e.g. "ada4f2k-a8k2"
  kind       String // SHARE (lister) | PROMO (approved sub-agent → commission)
  propertyId String
  creatorId  String
  clicks     Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  creator  User     @relation("ShareLinkCreator", fields: [creatorId], references: [id])

  @@unique([propertyId, creatorId, kind])
  @@index([creatorId])
}

// ++ ADDED — renters are invite-only. Single-use, sha256-hashed, 14-day link
// scoped to (inviter, property[, unit]). Accepting creates the Rental.
model TenantInvite {
  tokenHash  String    @id // sha256 of the raw token — raw never stored
  propertyId String
  unitId     String?
  inviterId  String
  renterId   String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  property Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     PropertyUnit? @relation(fields: [unitId], references: [id])
  inviter  User          @relation("TenantInviteSender", fields: [inviterId], references: [id])
  renter   User?         @relation("TenantInviteRenter", fields: [renterId], references: [id])

  @@index([propertyId])
  @@index([inviterId])
  @@index([expiresAt])
}

// ++ ADDED — an agent may only list for an owner who invited them.
model AgentInvite {
  tokenHash  String    @id
  ownerId    String
  agentEmail String?
  agentId    String? // set on accept
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  owner User @relation("AgentInviteOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
}

// ++ ADDED — the accepted relationship; powers the compulsory "property owner"
// dropdown in the agent's New Listing form.
model OwnerAgentLink {
  id        String   @id @default(cuid())
  ownerId   String
  agentId   String
  status    String   @default("ACTIVE") // ACTIVE | REVOKED
  createdAt DateTime @default(now())

  owner User @relation("OwnerAgentLinkOwner", fields: [ownerId], references: [id])
  agent User @relation("OwnerAgentLinkAgent", fields: [agentId], references: [id])

  @@unique([ownerId, agentId])
  @@index([agentId, status])
}

// ---------------------------------------------------------------------------
// ++ ADDED — third-party vendor services (fumigation, waste, inspection, repairs)
// ---------------------------------------------------------------------------
model Vendor {
  id       String   @id @default(cuid())
  name     String
  category String // FUMIGATION | WASTE | INSPECTION | REPAIRS
  rating   Float    @default(0)
  phone    String?
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())

  jobs ServiceJob[]

  @@index([category, isActive])
}

model ServicePlan {
  id              String   @id @default(cuid())
  name            String   @unique // Basic | Shield | Estate
  pricePerQuarter Decimal  @db.Decimal(10, 2)
