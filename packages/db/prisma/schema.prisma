// ============================================================================
// SUBSCRIPTION SYSTEM v2 — Add to your existing schema.prisma
// ============================================================================
// CHANGELOG v2:
//   - Renters are FREE now. RENTER_BASIC_PREMIUM removed entirely.
//   - RENTER_FREE plan added — all renters start here, no card, no expiry.
//   - RENTER_PREMIUM_PLUS kept — currently free for founding 300, paid later.
//   - FREE_ACTIVE status added — free plans never count as paid "ACTIVE".
//   - isFreeRenterPlan flag added — gates the future paid conversion without migration.
//   - renterPaidPlanUnlockedAt — timestamp for when you flip renters to paid billing.
//   - FREE_PLAN_CONVERTED event added for founding renter → paid conversion audit trail.
//
// INSTRUCTIONS:
// 1. Add the new models below to your packages/db/prisma/schema.prisma
// 2. Add the new enums below to your schema
// 3. Add the `subscription` and `subscriptionHistory` relations to your User model
// 4. Run: npx prisma migrate dev --name add_subscription_system
// ============================================================================


// ----------------------------------------------------------------------------
// STEP 1: Add these two lines inside your existing `model User { ... }`
// ----------------------------------------------------------------------------

// subscription        Subscription?
// subscriptionHistory SubscriptionHistory[]


// ----------------------------------------------------------------------------
// STEP 2: Add these NEW MODELS to your schema
// ----------------------------------------------------------------------------

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique   // One active subscription per user at a time

  // Plan Details
  planType              SubscriptionPlan               // Which plan they're on
  billingCycle          BillingCycle       @default(MONTHLY)
  userRole              Role                           // OWNER | AGENT | RENTER (mirrors User.role)

  // Pricing (stored at time of subscription — protects against future price changes)
  amountNaira           Decimal            @db.Decimal(10, 2)
  discountPercent       Decimal?           @db.Decimal(5, 2)  // e.g. 16.67 for "2 months free" annual
  finalAmountNaira      Decimal            @db.Decimal(10, 2) // Actual charged amount after discount

  // Flutterwave Subscription Data
  flwPlanId             String?            // Flutterwave payment plan ID
  flwSubscriptionId     String?  @unique   // Flutterwave subscription ID (returned after first charge)
  flwCustomerToken      String?            // Tokenized card — used for recurring charges
  flwTransactionRef     String?            // Last successful transaction reference
  flwCustomerId         String?            // Flutterwave customer ID

  // Subscription Lifecycle
  status                SubscriptionStatus @default(PENDING)
  currentPeriodStart    DateTime?          // When current billing period started
  currentPeriodEnd      DateTime?          // When current billing period ends (renewal date)
  trialEndsAt           DateTime?          // If a trial period is offered (future use)
  cancelledAt           DateTime?          // When user cancelled
  cancellationReason    String?            // Optional: why they cancelled
  pausedAt              DateTime?          // For future pause feature
  pausedUntil           DateTime?

  // Landlord-specific: property cap enforcement
  propertyListingCap    Int?               // null = unlimited (Elite), 2 = Essential cap
  currentPropertyCount  Int      @default(0) // Tracked count for cap enforcement

  // Agent-specific: founding cohort tracking
  isFoundingAgent       Boolean  @default(false)
  foundingAgentNumber   Int?               // Their number in the first-100 cohort (e.g. Agent #47)

  // Renter-specific: free plan + founding cohort
  // Renters are FREE now. isFreeRenterPlan = true means no charge ever runs for this subscription.
  // When you're ready to launch paid billing, set renterPaidPlanUnlockedAt — that's the only change needed.
  isFreeRenterPlan        Boolean   @default(false)   // true for RENTER_FREE and founding RENTER_PREMIUM_PLUS
  renterPaidPlanUnlockedAt DateTime?                  // Set by admin/script when paid renter billing launches
                                                      // Until this is set, the renewal cron skips this record entirely

  isFoundingMember        Boolean   @default(false)
  foundingMemberNumber    Int?                        // Their number in first-300 cohort
  lockedRateNaira         Decimal?  @db.Decimal(10, 2) // Rate charged on first renewal after paid billing launches
                                                        // Founding renters are NEVER charged current plan price

  // Marking job access (agents on Premium + renters on Premium Plus)
  canAccessMarkingJobs    Boolean   @default(false)

  // Auto-renewal
  autoRenew             Boolean  @default(true)
  nextRenewalAttempt    DateTime?          // Scheduled next charge attempt
  renewalFailureCount   Int      @default(0) // How many times renewal has failed
  lastRenewalAttemptAt  DateTime?

  // Virtual account trigger (for Premium renters — created after subscription activates)
  virtualAccountCreated Boolean  @default(false)

  // Relations
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  history               SubscriptionHistory[]
  invoices              SubscriptionInvoice[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([planType])
  @@index([userRole])
  @@index([currentPeriodEnd])  // For renewal jobs — query "find subscriptions expiring soon"
  @@index([flwSubscriptionId])
  @@index([isFoundingAgent])
  @@index([isFoundingMember])
}


// Tracks every status change — for auditing, support, and analytics
model SubscriptionHistory {
  id               String             @id @default(cuid())
  subscriptionId   String
  userId           String

  // What changed
  eventType        SubscriptionEvent
  fromStatus       SubscriptionStatus?
  toStatus         SubscriptionStatus?
  fromPlan         SubscriptionPlan?
  toPlan           SubscriptionPlan?

  // Payment context (if this event was triggered by a payment)
  flwTransactionRef String?
  amountCharged     Decimal?          @db.Decimal(10, 2)
  paymentStatus     PaymentStatus?

  // Metadata
  notes            String?            // e.g. "Renewal failed — card declined"
  triggeredBy      String?            // "system" | "user" | "admin" | userId

  subscription     Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())

  @@index([subscriptionId])
  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}


// One record per billing cycle charge — your receipts/invoices system
model SubscriptionInvoice {
  id                String        @id @default(cuid())
  subscriptionId    String
  userId            String

  // Invoice details
  invoiceNumber     String        @unique  // e.g. "NC-INV-2024-000001"
  periodStart       DateTime
  periodEnd         DateTime
  amountNaira       Decimal       @db.Decimal(10, 2)
  currency          String        @default("NGN")

  // Payment result
  status            InvoiceStatus @default(PENDING)
  flwTransactionRef String?       @unique
  flwTransactionId  String?       @unique
  paidAt            DateTime?
  failureReason     String?
  retryCount        Int           @default(0)
  nextRetryAt       DateTime?

  subscription      Subscription  @relation(fields: [subscriptionId], references: [id])
  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([subscriptionId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}


// Flutterwave payment plans — created once via API, reused for all subscribers
// You create these once (via script or admin panel), then store the IDs here
model FlutterwavePlan {
  id              String       @id @default(cuid())

  // Plan identity
  planType        SubscriptionPlan  @unique  // Maps 1:1 to your subscription plans
  name            String            // Human-readable: "NewCondo Elite — Monthly"
  description     String?

  // Flutterwave data
  flwPlanId       String       @unique  // The plan ID from Flutterwave's API
  flwPlanCode     String?              // Flutterwave's internal plan code

  // Pricing
  amountNaira     Decimal      @db.Decimal(10, 2)
  billingCycle    BillingCycle
  interval        String       // "monthly" | "yearly" — Flutterwave's format

  // Status
  isActive        Boolean      @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([planType])
  @@index([flwPlanId])
}


