{
  "name": "newcondo",
  "private": true,
  "workspaces": [
    "apps/*",
    "backend/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "prisma generate",
    "install:platform": "pnpm install --filter=@newcondo/db && pnpm install",
    "build:backend": "pnpm run build --filter=@newcondo/db && pnpm run build --filter=@newcondo/backend-shared && pnpm run build --filter=@newcondo/auth-service && pnpm run build --filter=@newcondo/combined-backend",
    "build:platform":"pnpm run build --filter=@newcondo/db && pnpm run build --filter=@newcondo/platform",
    "start:backend": "cd backend/combined-backend && pnpm run start",
    "start:platform-dev": "concurrently \"pnpm --filter combined-backend dev\" \"pnpm --filter platform dev\"",
    "start:platform":""
  },
  "devDependencies": {
    "@newcondo/eslint-config": "workspace:*",
    "@newcondo/typescript-config": "workspace:*",
    "@types/node": "^22.15.29",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
